{
  "name": "insula-jocurilor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Jocuri educative pentru copii de 4-10 ani, pentru tabletă cu creion.",
  "scripts": {
    "dev": "vite --port 5190 --host",
    "build": "vite build",
    "preview": "vite preview --port 5191",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc --noEmit && biome check .",
    "format": "biome check --write .",
    "e2e": "playwright test",
    "voice": "node --experimental-strip-types --no-warnings tools/voice.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fredoka": "5.3.0",
    "@fontsource/andika": "5.3.0",
    "@iconify-json/fluent-emoji-flat": "1.2.6",
    "@iconify/utils": "3.1.7",
    "canvas-confetti": "1.9.4",
    "idb-keyval": "6.3.0",
    "motion": "14.14.0",
    "perfect-freehand": "1.2.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/canvas-confetti": "1.9.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "fake-indexeddb": "6.2.8",
    "happy-dom": "^21.0.4",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.1",
    "workbox-window": "7.4.1"
  }
